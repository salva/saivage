{
  "$schema": "https://typedoc.org/schema.json",
  "skipErrorChecking": true,
  "entryPoints": [
    "src/index.ts",
    "src/types.ts",
    "src/config.ts",
    "src/agents/base.ts",
    "src/agents/conventions.ts",
    "src/agents/prompt-keys.ts",
    "src/agents/roster.ts",
    "src/agents/types.ts",
    "src/runtime/dispatcher.ts",
    "src/runtime/lifecycle.ts",
    "src/runtime/notes.ts",
    "src/runtime/recovery.ts",
    "src/runtime/supervisor.ts",
    "src/providers/credential-resolver.ts",
    "src/providers/types.ts",
    "src/providers/router.ts",
    "src/providers/router-utils.ts",
    "src/mcp/client.ts",
    "src/mcp/runtime.ts",
    "src/mcp/types.ts",
    "src/mcp/toolContext.ts",
    "src/mcp/plan-server.ts",
    "src/events/bus.ts",
    "src/channels/types.ts",
    "src/rag/chunker/index.ts",
    "src/rag/dataset.ts",
    "src/rag/manager.ts",
    "src/rag/provider/index.ts",
    "src/rag/store/index.ts",
    "src/rag/types.ts",
    "src/routing/resolver.ts",
    "src/server/bootstrap.ts",
    "src/server/planner-runner.ts",
    "src/server/rag/service.ts",
    "src/server/server.ts",
    "src/store/project.ts",
    "src/store/project-store.ts",
    "src/store/stage-run-store.ts",
    "src/store/documents.ts",
    "src/knowledge/init.ts",
    "src/knowledge/sidecar.ts",
    "src/knowledge/eagerLoader.ts",
    "src/knowledge/loader.ts"
  ],
  "tsconfig": "tsconfig.json",
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "readme": "none",
  "exclude": ["**/*.test.ts", "web/**", "node_modules/**"],
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "hideGenerator": true,
  "githubPages": false,
  "sort": ["kind", "alphabetical"],
  "includeVersion": true,
  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table",
  "propertiesFormat": "table",
  "enumMembersFormat": "table",
  "typeDeclarationFormat": "table",
  "indexFormat": "table",
  "docsRoot": "docs"
}
